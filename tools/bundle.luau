-- packs the xenon cli into one luau file that lune build can turn into a standalone exe:
--   lune run tools/bundle.luau                  -> dist/xenon.luau
--   lune build dist/xenon.luau -o dist/xenon    -> exe (the release workflow does this per platform)
-- every src/ module becomes a function in the file, and src/assets is replaced by one that holds
-- the plugin sources and the template, so the exe needs nothing on disk.

local fs = require("@lune/fs")

local assets = require("../src/assets")

local OUT_DIR = "dist"
local OUT = OUT_DIR .. "/xenon.luau"

-- exact luau string literal for any text (keeps \r, tabs, unicode bytes)
local function literal(text: string): string
	local escaped = text:gsub('[%c"\\]', function(char)
		if char == "\n" then
			return "\\n"
		elseif char == "\t" then
			return "\\t"
		elseif char == '"' then
			return '\\"'
		elseif char == "\\" then
			return "\\\\"
		end
		return string.format("\\%03d", string.byte(char))
	end)
	return '"' .. escaped .. '"'
end

local function table_literal(map: { [string]: string }): string
	local keys = {}
	for key in map do
		table.insert(keys, key)
	end
	table.sort(keys)
	local lines = { "{" }
	for _, key in keys do
		table.insert(lines, "\t[" .. literal(key) .. "] = " .. literal(map[key]) .. ",")
	end
	table.insert(lines, "}")
	return table.concat(lines, "\n")
end

local plugin = assets.plugin()
local template = assets.template()

local baked_assets = table.concat({
	"local assets = {}",
	"assets.bundled = true",
	"local PLUGIN = " .. table_literal(plugin),
	"local TEMPLATE = " .. table_literal(template),
	"function assets.plugin() return table.clone(PLUGIN) end",
	"function assets.template() return table.clone(TEMPLATE) end",
	'function assets.read_tree() error("assets.read_tree is not available in the release exe") end',
	"return assets",
}, "\n")

-- module name (path without .luau, from the xenon folder) -> source
local modules = { ["src/assets"] = baked_assets }
for _, name in fs.readDir("src") do
	local module = name:match("^(.+)%.luau$")
	if module and module ~= "assets" then
		modules["src/" .. module] = fs.readFile("src/" .. name)
	end
end
modules["xenon"] = fs.readFile("xenon.luau")

local names = {}
for name in modules do
	table.insert(names, name)
end
table.sort(names)

local LOADER = [[
-- generated by tools/bundle.luau from the xenon source. do not edit.
local __lune_require = require
local __modules = {}
local __cache = {}

local function __normalize(path)
	local out = {}
	for part in path:gmatch("[^/]+") do
		if part == ".." then
			table.remove(out)
		elseif part ~= "." then
			table.insert(out, part)
		end
	end
	return table.concat(out, "/")
end

local function __require_from(dir)
	return function(path)
		if path:sub(1, 1) == "@" then
			return __lune_require(path)
		end
		local name = __normalize((dir ~= "" and dir .. "/" or "") .. (path:gsub("%.luau$", "")))
		if __cache[name] == nil then
			local loader = __modules[name]
			if not loader then
				error("bundled module not found: " .. name)
			end
			__cache[name] = loader(__require_from(name:match("^(.*)/[^/]+$") or ""))
		end
		return __cache[name]
	end
end]]

local parts = { LOADER }
for _, name in names do
	table.insert(parts, "__modules[" .. literal(name) .. "] = function(require)\n" .. modules[name] .. "\nend")
end
table.insert(parts, '__require_from("")("./xenon")')

if not fs.isDir(OUT_DIR) then
	fs.writeDir(OUT_DIR)
end
local bundle = table.concat(parts, "\n\n")
fs.writeFile(OUT, bundle)

local template_count = 0
for _ in template do
	template_count += 1
end
print(`[bundle] {OUT} ({#bundle} bytes, {#names} modules, {template_count} template files)`)
